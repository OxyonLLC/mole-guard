# =========================
# MOLE GUARD (Bot + Web + Linked Roles)
# =========================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1464098806873456834
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=1335712781462409308

PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
PUBLIC_PORT=8788
DISCORD_REDIRECT_URI=http://localhost:8787/discord-oauth-callback?app=mole

TOKEN_PEPPER=change_me_to_a_long_random_string

# ─── Solana RPC ───────────────────────────────────────────────────────────
# REQUIRED: replace REPLACE_WITH_ALCHEMY_KEY with the project's Alchemy key
# (owner has it; same key already used for EVM chains). Do NOT leave a bare
# public endpoint here as the primary.
#
# Why: api.mainnet-beta.solana.com throttles and HANGS on
# getParsedTokenAccountsByOwner — the balance lookup behind wallet
# verification, holder roles and payouts. It reached users as
# "Verify failed: rpc_timeout:getParsedTokenAccountsByOwner" on /verify/
# (2026-07-31). Keep the public endpoint only as the FALLBACK below.
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_KEY
# Only tried when the primary fails — see withRpcFailover() in
# src/mole/solana.js. Safe to leave as the free public endpoint.
SOLANA_RPC_FALLBACK=https://api.mainnet-beta.solana.com
# ──────────────────────────────────────────────────────────────────────────
WINLEW_MINT=DnrcdQVH7fdbmm4EyD7LjT9mNNozF5HuWMeKcpvjpump

THRESHOLD_1M=1000000
THRESHOLD_10M=10000000
THRESHOLD_100M=100000000

DATA_DIR=./data

# =========================
# CLAUDE / ANTHROPIC (optional AI helper for Watchdog)
# =========================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# =========================
# WATCHDOG
# =========================
WATCHDOG_DISCORD_TOKEN=
WATCHDOG_PORT=8790
# Local-only Watchdog target used by the public web relay at /watchdog.
# Keep ngrok pointed at PORT (8787); never start a second tunnel for 8790.
WATCHDOG_LOCAL_URL=http://127.0.0.1:8790
WATCHDOG_DATA_DIR=./data-watchdog
WATCHDOG_ALERT_CHANNEL_ID=1350969543480180817
WATCHDOG_SECURITY_ENABLED=true
WATCHDOG_SECURITY_LOG_CHANNEL_ID=
WATCHDOG_SECURITY_ALLOWED_DOMAINS=winlew.co,www.winlew.co,discord.com,discord.gg
WATCHDOG_SECURITY_TRUSTED_ROLE_IDS=
WATCHDOG_SECURITY_NEW_MEMBER_WINDOW_MINUTES=120
WATCHDOG_SECURITY_MIN_ACCOUNT_AGE_DAYS=21
WATCHDOG_SECURITY_TIMEOUT_MINUTES=0
# Impersonation-name handling. BAN names are auto-banned (trusted roles/admins/bots
# excluded); FLAG names are warned + alerted (not banned). Comma-separated; emoji /
# leetspeak / spacing variants are normalized automatically. Needs the bot to have
# "Ban Members" (to ban) and "Manage Server" (to surface the join invite).
WATCHDOG_IMPERSONATION_ENABLED=true
WATCHDOG_IMPERSONATION_BAN_NAMES=announcements,announcement,airdrop,partnership
WATCHDOG_IMPERSONATION_FLAG_NAMES=support
WATCHDOG_CHAT_ALLOWED_USER_IDS=
WATCHDOG_CHAT_ALLOWED_ROLE_IDS=
WATCHDOG_PRESENCE_GUILD_ID=
# Comma-separated lists. Prefer stable bot user IDs; tags remain useful for
# readable configuration and backward compatibility.
WATCHDOG_PRESENCE_USER_IDS=
WATCHDOG_PRESENCE_USER_TAGS="GeoHackers#5890"
# Legacy single-target settings are still supported.
WATCHDOG_PRESENCE_USER_ID=
WATCHDOG_PRESENCE_USER_TAG="GeoHackers#5890"
WATCHDOG_PRESENCE_LOG_CHANNEL_ID=
WATCHDOG_AUDIT_ENABLED=true
WATCHDOG_AUDIT_CHANNEL_ID=
WATCHDOG_AUDIT_INTERVAL_SEC=600
WATCHDOG_AUDIT_BOT_TAGS=WinLEW-UtilityBot#5306,The Mole Gaurd#6400
WATCHDOG_AUDIT_BOT_USER_IDS=
WATCHDOG_UTILITY_BOT_WALLET=diglew.sol

WATCHDOG_HEARTBEAT_TOKEN=change_me_to_a_long_random_string

HEARTBEAT_INTERVAL_SEC=60
HEARTBEAT_TIMEOUT_SEC=90
WATCHDOG_URL=http://localhost:8790

MAINTENANCE_MODE=false
MAINTENANCE_REASON=

# Optional: used by npm run dev:all when you want ngrok to start automatically
NGROK_AUTHTOKEN=
