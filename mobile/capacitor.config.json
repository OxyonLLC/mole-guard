{
  "appId": "co.winlew.app",
  "appName": "WinLEW",
  "webDir": "www",
  "server": {
    "url": "https://winlew.co/app/start/",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#130b08"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#130b08",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
