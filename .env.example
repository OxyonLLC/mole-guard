MOLE_DISCORD_REDIRECT_URI=
UTILITY_DISCORD_CLIENT_ID=
UTILITY_DISCORD_CLIENT_SECRET=
UTILITY_DISCORD_REDIRECT_URI=

# Verification / audit webhooks (optional)
VERIFICATION_WEBHOOK_URL=
VERIFICATION_WEBHOOK_URL_MOLE=
VERIFICATION_WEBHOOK_URL_UTILITY=
VERIFICATION_WEBHOOK_URL_WATCHDOG=
# Discord channel webhook — posts a message every time someone submits a new
# governance proposal idea via /governance/submit/. Optional, silently
# skipped if unset. See docs/governance-v1.md's "Proposal publishing" section.
GOVERNANCE_WEBHOOK_URL=

# ─── Governance leaderboard privacy gate ──────────────────────────────────
# /leaderboards/'s Governance board publishes WHO takes part, never HOW they
# voted. Those stay compatible only while enough people have voted that a row
# can't be traced back to a choice — with one voter and a public 1-0 tally,
# naming the voter names their vote. Below this many distinct voters the API
# returns counts only: no names, no ids, no choices. Enforced server-side.
GOVERNANCE_LEADERBOARD_MIN_VOTERS=5
# ──────────────────────────────────────────────────────────────────────────

# Linked Roles metadata registration retry controls
ROLE_METADATA_RETRY_MAX_ATTEMPTS=6
ROLE_METADATA_RETRY_BUFFER_MS=500
ROLE_METADATA_BETWEEN_APPS_DELAY_MS=1500

# Optional direct guild role sync after verification
GUILD_ROLE_SYNC_ENABLED=true
GUILD_ROLE_DIAGNOSTICS_ON_START=true
GUILD_ROLE_SYNC_BOT_TOKEN=
VERIFIED_WALLET_ROLE_ID=
VERIFIED_HOLDERS_ROLE_ID=
LEWCREW_1M_ROLE_ID=
LEWCREW_10M_ROLE_ID=
LEWCREW_100M_ROLE_ID=
CONTRIBUTOR_ROLE_ID=
GOVERNANCE_VOTER_ROLE_ID=


# Website / UI split
PUBLIC_BASE_URL=https://orthomorphic-laevorotatory-trista.ngrok-free.dev
SITE_BASE_URL=https://winlew.co
VERIFY_UI_URL=https://winlew.co/verify/
BOT_SERVICES_URL=https://winlew.co/discord-bots/
GAMING_HUB_URL=https://winlew.co/mole-hub/
DISCORD_ACTIVITY_ENABLED=false
# Session link handed out alongside /game hub launches so Mole Hub can attach
# rewards to the invoking Discord user on the same client before/while Activity
