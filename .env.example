GEOAGORA_API_LOCAL_URL=http://127.0.0.1:3001
GEOAGORA_ALERTS_ENABLED=false
GEOAGORA_ALERT_POLL_SEC=60
GEOAGORA_BASE_URL=https://winlew.co/geoagora/

