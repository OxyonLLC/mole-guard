DISCORD_ACTIVITY_SESSION_TTL_SEC=21600
WATCHDOG_URL=https://winlew.co/health/
CORS_ALLOWED_ORIGINS=https://winlew.co,https://www.winlew.co

# Gaming-hub reward-claim validation (server recomputes payout = baseReward * multiplier)
#   shadow (default) — recompute payout (blocks injection) but treat caps as log-only
#   clamp (default)  — also clamp banked amount to base/per-claim/daily caps, no error
#   reject           — refuse (HTTP 400) any claim that trips a rule
# clamp is the safe default: shadow only logs cap breaches while still banking
# the full amount, so a forged baseReward is payable. Only use shadow for a
# deliberate, monitored rollout window.
REWARD_VALIDATION_MODE=clamp
# Safety interlock: shadow mode is IGNORED (auto-downgraded to clamp, with a
# loud boot warning) unless you ALSO set this. Two vars to run the unsafe mode.
# REWARD_ALLOW_SHADOW=true
# Comma-separated reward-box multipliers a claim may use (default 0.5,1,1.5,2)
REWARD_ALLOWED_MULTIPLIERS=0.5,1,1.5,2
# Caps grounded in the real economy (faucet drips ~1500/day). Override per game
# with a _<GAME> suffix, e.g. REWARD_MAX_BASE_REWARD_PACMOLE.
# Base cap * max 2x box = the per-claim ceiling (1250*2 = 2500 ~= pacmole L24).
REWARD_MAX_BASE_REWARD=1250
# REWARD_MAX_BASE_REWARD_PACMOLE=1250
REWARD_PER_CLAIM_MAX_PAYOUT=2500
# Rolling per-user throughput caps (4500/day = 3x faucet; 60 claims/hr)
REWARD_DAILY_MAX_PAYOUT=4500
REWARD_HOURLY_MAX_CLAIMS=60
# One-time capped credit when a guest connects, for local winnings that predate
# guest-id recording (defaults to the daily cap).
REWARD_MIGRATION_CAP=4500

# Daily game-payout worker (runner service: gamepayouts). Pays accrued game
# winnings once a day in bundled txs. Faucet is separate + stays automatic.
# DEFAULTS TO DRY RUN — computes + logs the batch but sends nothing until false.
GAME_PAYOUTS_DRY_RUN=true
# Skip + carry forward users under this WinLEW total (dust threshold).
# Matched to the faucet's DRIP_AMOUNT (1500) — no payout smaller than one drip.
GAME_PAYOUT_MIN=1500
# Recipients bundled per transaction (keep modest for tx size limits)
GAME_PAYOUT_BUNDLE_SIZE=6
# Defense-in-depth: hold (don't auto-pay) any single user whose one-run total
# exceeds this, and alert the-logs channel. ~5+ days at the 4500/day cap. 0=off.
GAME_PAYOUT_MAX_PER_USER=25000
# Cron (6-field, seconds) + timezone — default 00:00:01 UTC
GAME_PAYOUT_CRON=1 0 0 * * *
GAME_PAYOUT_TZ=UTC
# Treasury signer + RPC (default to the shared faucet/quiz keypair + SOLANA_RPC)
# GAME_PAYOUT_KEYPAIR_PATH=src/faucet/bot-keypair.json
# GAME_PAYOUT_RPC_URL=
# Run one batch immediately on boot (ops/testing); leave false in normal service
GAME_PAYOUT_RUN_NOW=false
# Discord webhook for the-logs channel — posts a summary each run (dry-run + live).
# Create one in that channel (Channel Settings → Integrations → Webhooks). Optional.
GAME_PAYOUT_LOG_WEBHOOK_URL=

# XL1 Arcade — dry-run by default; configure and start the separate worker for live payouts.
XL1_REWARD_MODE=dry-run
XL1_GAME_REWARDS_ENABLED=true
XL1_REWARD_PER_POINT=0.05
XL1_DAILY_REWARD_CAP=10
XL1_DISTRIBUTOR_ADDRESS=e5f3f3349cc84d730e7f3332939f98da24639002
XL1_ARCADE_SESSIONS_COLLECTION=xl1_arcade_sessions
XL1_ARCADE_LEDGER_COLLECTION=xl1_arcade_reward_days
# Live adapter name: xl1-sdk. Live mode also requires network, RPC, chain ID and verification file.
XL1_REWARD_SIGNER_ADAPTER=
# Read-only sender preflight: absolute path to a PRIVATE sender.js credential file.
# Never place the file beneath src/public or commit its contents.
XL1_SENDER_FILE=
# Optional absolute path to GeoHackers' installed xl1-sdk dist/neutral/index.mjs.
XL1_SDK_MODULE=
# Absolute path to GeoHackers .bot-verification-db.json (native XL1 signatures only).
XL1_VERIFICATION_FILE=
# The arcade's "Verify XL1 wallet" button: the same secret as the GeoHackers bot's
# GEOHACKERS_WEB_VERIFY_TOKEN. Empty keeps the button unavailable.
GEOHACKERS_WEB_VERIFY_TOKEN=
# Explicit network configuration; never infer beta/mainnet from the credential.
XL1_NETWORK=beta
XL1_RPC_URL=https://beta.api.chain.xyo.network/rpc
# Expected 40-character chain ID; the worker rejects a mismatched RPC chain.
XL1_CHAIN_ID=4b43a753c8024c0e5000e8ac948ac0063ac624bc
# Worker balance thresholds in XL1 (defaults 100 warning / 20 reserve).
DISTRIBUTOR_LOW_BALANCE_WARNING=100
DISTRIBUTOR_PAYOUT_PAUSED_THRESHOLD=20

# Web-playable quiz (winlew.co/quiz/). Discord quiz stays unlimited/admin-paced.
# Anti-farm: scored answers/user/day (UTC) + per-question answer timer.
QUIZ_WEB_DAILY_CAP=20
QUIZ_WEB_TIME_LIMIT_SEC=30
# Quiz redemption floor in WinLEW, matched to the faucet's DRIP_AMOUNT: manual
# /redeem (Discord + web) rejects below it, cycle close carries below-floor
# balances into the open cycle instead of settling dust on-chain.
QUIZ_MIN_REDEMPTION_WINLEW=1500

