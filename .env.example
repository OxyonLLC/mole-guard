# =========================
# MERCH SHOP (/merch/)
# =========================
# Checkout is SERVER-PRICED. Both values are required; with only the client id
# the page deliberately shows "PayPal checkout coming online" rather than
# rendering buttons it cannot safely back.
#
# This block used to say "NEVER put the PayPal secret anywhere," which was
# written when checkout ran entirely in the browser — and that instruction is
# exactly what kept the hole open. PayPal's REST API authenticates with
# client_credentials, so server-side order creation is impossible without the
# secret, and without server-side order creation the BROWSER names the price.
#
# It is safe here for a checkable reason: this Node process does not run on the
# shared web host. That host serves static files and a PHP proxy; the backend
# runs on the owner's own machine behind a tunnel, already holding
# DISCORD_TOKEN, MONGO_URI and a Solana keypair that controls real funds. A
# PayPal client secret is strictly less dangerous than the keypair beside it.
# It must still never reach src/public/, a commit, or the web host.
#
# Client id is public by design (it appears in the SDK URL). The secret is not.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. Defaults to sandbox on purpose: a misconfigured
# deploy should fail to take money, not take it for real.
PAYPAL_ENV=sandbox
# Holder discount on $WinLEW drops: 1% per 1M $WinLEW held, capped at 15%.
# Server-computed from the session's verified wallet (/api/merch/discount).
MERCH_DISCOUNT_PCT_PER_MILLION=1
MERCH_DISCOUNT_CAP_PCT=15

# =========================
# CLAUDE / ANTHROPIC (Watchdog AI helper + the owner-only WinLEW Forge)
# =========================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# =========================
# WinLEW Forge (internal, owner-only AI studio at /winlew-forge/)
# =========================
# The Forge's Anthropic "brain" defaults to claude-opus-4-8 (override with
# CLAUDE_MODEL above). Its OpenAI "brain" is OPTIONAL — leave OPENAI_API_KEY
# unset and that brain returns "not configured" instead of running.
# OPENAI_API_KEY=
# Access is gated to WinLEW maintainers — the comma-separated MOD_IDS list of
# Discord IDs (same list governance uses). Only those sessions can run a brain,
# so the server's API keys can't be spent by the public.

# =========================
# WATCHDOG (optional)
# =========================
WATCHDOG_DISCORD_TOKEN=
WATCHDOG_PORT=8790
# Local-only Watchdog target used by the public web relay at /watchdog.
# Keep ngrok pointed at PORT (8787); never start a second tunnel for 8790.
WATCHDOG_LOCAL_URL=http://127.0.0.1:8790
# Standalone GeoHackers services, published through port 8787. These are
# loopback only while GeoHackers runs on this same PC. When the bot lives
# on another machine, point them at a URL THIS PC can reach -- its
# Tailscale funnel, for instance:
#   GEOHACKERS_VERIFY_LOCAL_URL=https://your-bot-host.example.ts.net
# The relay rewrites the Host header for non-loopback targets, so a
# name-routed backend still recognises its own hostname.
#
# If GeoHackers is containerized alongside Mole Guard and both are attached to
# the shared external Docker network "geo-mole-net" (see docker-compose.yml),
# use its container DNS aliases instead of loopback/Tailscale:
#   GEOHACKERS_API_LOCAL_URL=http://geohackers-api:8791
#   GEOHACKERS_VERIFY_LOCAL_URL=http://geohackers-bot:8793
GEOHACKERS_API_LOCAL_URL=http://127.0.0.1:8791
GEOHACKERS_VERIFY_LOCAL_URL=http://127.0.0.1:8793
WATCHDOG_DATA_DIR=./data-watchdog
WATCHDOG_ALERT_CHANNEL_ID=1350969543480180817
WATCHDOG_SECURITY_ENABLED=true
WATCHDOG_SECURITY_LOG_CHANNEL_ID=
WATCHDOG_SECURITY_ALLOWED_DOMAINS=winlew.co,www.winlew.co,discord.com,discord.gg
WATCHDOG_SECURITY_TRUSTED_ROLE_IDS=
WATCHDOG_SECURITY_NEW_MEMBER_WINDOW_MINUTES=120
WATCHDOG_SECURITY_MIN_ACCOUNT_AGE_DAYS=21
WATCHDOG_SECURITY_TIMEOUT_MINUTES=0
# Impersonation guard: flags/bans display-name spoofing of staff/official handles
WATCHDOG_IMPERSONATION_ENABLED=true
WATCHDOG_IMPERSONATION_BAN_NAMES=announcements,announcement,airdrop,partnership
WATCHDOG_IMPERSONATION_FLAG_NAMES=support
WATCHDOG_CHAT_ALLOWED_USER_IDS=
WATCHDOG_CHAT_ALLOWED_ROLE_IDS=
WATCHDOG_PRESENCE_GUILD_ID=
WATCHDOG_PRESENCE_USER_IDS=
WATCHDOG_PRESENCE_USER_TAGS="GeoHackers#5890"
# Legacy single-target settings are still supported.
WATCHDOG_PRESENCE_USER_ID=
WATCHDOG_PRESENCE_USER_TAG="GeoHackers#5890"
WATCHDOG_PRESENCE_LOG_CHANNEL_ID=
WATCHDOG_AUDIT_ENABLED=true
WATCHDOG_AUDIT_CHANNEL_ID=
WATCHDOG_AUDIT_INTERVAL_SEC=600
WATCHDOG_AUDIT_BOT_TAGS=WinLEW-UtilityBot#5306,The Mole Gaurd#6400
WATCHDOG_AUDIT_BOT_USER_IDS=
WATCHDOG_UTILITY_BOT_WALLET=diglew.sol

WATCHDOG_HEARTBEAT_TOKEN=change_me_to_a_long_random_string

HEARTBEAT_INTERVAL_SEC=60
HEARTBEAT_TIMEOUT_SEC=90
# Where services SEND heartbeats. localhost when they share a machine with the
# watchdog; on another machine use the watchdog host's tailnet address, e.g.
#   WATCHDOG_URL=http://100.74.64.111:8790
# A tailnet address is stable for the life of the machine, unlike a free tunnel
# hostname, which is regenerated every restart and silently takes the monitoring
# with it. WATCHDOG_HEARTBEAT_TOKEN must match on both sides.
WATCHDOG_URL=http://localhost:8790

MAINTENANCE_MODE=false
MAINTENANCE_REASON=Planned maintenance

# Optional: used by npm run dev:all when you want ngrok to start automatically
NGROK_AUTHTOKEN=
NGROK_ENABLED=true
# Optional native CLI override. Otherwise use .tools/ngrok when installed, then PATH.
# NGROK_BIN=/absolute/path/to/ngrok

# --- Per-IP rate limiting behind the tunnel -------------------------------
# Every request reaches this server from the local ngrok agent, so the socket
# address is always loopback and visitors are told apart by forwarded headers.
# The ngrok origin is public, so those headers are only trusted as far as they
# can be verified. See src/mole/clientIp.js.
#
# Which upstream hops may set X-Forwarded-For. Default (blank) trusts only
# loopback — i.e. the tunnel agent — so req.ip is the address ngrok itself
# observed and cannot be forged. Add IPs/CIDRs only for a real reverse proxy
# you run; "false" trusts nothing. Never set this to `true`/`*` (ignored).
WEB_TRUSTED_PROXY_IPS=
#
# Lets winlew.co/verify/api-proxy.php vouch for the browser IP it saw, so
# proxied visitors get their own rate-limit budget instead of sharing the
# shared host's. Must match WINLEW_PROXY_SECRET on the proxy (env var, or an
# api-proxy-secret.php beside it returning the string). Leave blank to run
# without it — limits then bucket all winlew.co traffic together. SECRET.
#
# ⚠️ 2026-08-12 — SUSPECTED UNSET ON THE SERVING MACHINE (audit register #27).
# The PHP side is known present; if this side is blank the 2026-08-01 per-IP
# rate-limit fix is INERT. It fails safe, so nothing is broken — the limiter
# just buckets every winlew.co visitor together. Nobody has been able to check,
# because this file is gitignored and cannot be pushed between machines.
#
#   Check (on the serving PC, prints 1 or 0 — never print the value):
#     grep -c '^WEB_PROXY_SHARED_SECRET=.\+' .env
#
#   Second check, no shell needed: if it is unset, the backend logs
#   "[security] WEB_PROXY_SHARED_SECRET is unset ..." at every boot.
#
#   To set: openssl rand -hex 32, then put the SAME value here AND in
#   WINLEW_PROXY_SECRET on the shared host. Must be printable ASCII, no CR/LF,
#   8-256 chars, or api-proxy.php drops it silently.
#
# Full walkthrough for whoever is at that machine:
#   A.i-Talks/proxy-secret-2026-08-12.md
WEB_PROXY_SHARED_SECRET=

# ─── Review queue safety valve (2026-08-14) ──────────────────────────────
# A payout held for human review is only fail-open if a human actually turns up.
# If nobody reads the channel that week, the participant is never paid, never
# told, and nothing says so — fail-CLOSED wearing a fail-open costume.
#
# So a hold is a TIMER. A soft hold nobody reviewed by its deadline is released
# and paid, recorded as `auto_released` rather than `approved` so an unattended
# queue can never masquerade as a reviewed one. While it waits, it is announced
# again as it ages, and a digest of everything held fires on a schedule whether
# or not anything changed.
#
# NOTHING here can auto-REJECT. The timer only ever runs in the participant's
# favour. Holds linked to a BANNED wallet never auto-release either — a human
# banned that on purpose and a timer must not overrule them; those escalate.
QUIZ_REVIEW_SLA_HOURS=72
# ON BY DEFAULT, and that default is the point: enforcement without this valve
# is a money black hole. Turning it off means you have chosen to hold earned
# payouts indefinitely — the queue then escalates instead of going quiet.
QUIZ_REVIEW_AUTO_RELEASE_ENABLED=true
QUIZ_REVIEW_DIGEST_HOURS=24
QUIZ_REVIEW_ESCALATE_HOURS=24

# ─── First-payout provenance check (2026-08-14) ──────────────────────────
# The owner declined a holder minimum — any holder should be able to earn — and
# asked for a check on the FIRST payout instead: who funded this wallet, do they
# play here, do they still hold, is this the same person or a friend.
#
# Keyed on the Discord account, not the wallet: keying on the wallet would make
# every new wallet a clean slate, which is the loophole itself. Runs once per
# person, then never again.
#
# It never rejects — the worst verdict is `review`, which holds the payout with
# the points intact for `!quizreview`. It fails OPEN: an RPC outage, a truncated
# walk or any throw settles the payout and records why.
QUIZ_FIRST_PAYOUT_CHECK_ENABLED=false
#
# A FLAGGED FIRST PAYOUT IS STILL PAID, IN FULL, IMMEDIATELY. There is no switch
# that changes that. Making a brand new participant wait days for money they
# earned, on circumstantial evidence, to catch a farmer who will simply wait too,
# costs every honest newcomer and stops nobody. A flag puts them on the
# watchlist instead, which gates their SECOND payout — one payout is a cheap
# price for real evidence, and redeem/move/relink/repeat only becomes visible on
# the repeat anyway.
#
# The gate on that second payout. Off by default; read the shadow output first.
# Anything it holds still auto-releases on the review SLA above, and an admin
# clearing the flag frees it immediately.
QUIZ_WATCHLIST_GATE_ENABLED=false
# Roles allowed to run !quizwatch / !quizclear / !quizreview / !quizapprove /
# !quizreject. Defaults to the server's Admin role, so every admin can act
# without configuration — a review queue only one person can clear is the same
# hole as one nobody reads. MOD_IDS still works alongside this.
QUIZ_REVIEWER_ROLE_IDS=1350888808283115630

# ─── Payout receipts / GeoProof (Stages 5 & 6, 2026-08-14) ───────────────
# A receipt answers "why did this payout happen?" in a form someone can check
# without trusting our database, our screenshots, or our payout worker.
#
# WinLEW does NOT depend on @xyo-network. The receipt payload and its hash are
# built here with node:crypto only; the XYO half lives in a separate GeoProof
# service so a version conflict or an outage cannot touch the payout path.
# A receipt is evidence produced ALONGSIDE a payout, never a gate on one.
GEOPROOF_RECEIPTS_ENABLED=false
# REQUIRED once receipts are on. Participant and wallet appear only as salted
# references — a reviewer holding the DB can confirm one, a stranger holding the
# receipt learns nothing. No salt means no receipt rather than an unsalted one.
# SECRET.
PAYOUT_RECEIPT_SALT=
# Optional. Without it receipts are still built, hashed and replayable — they
# simply carry no third-party attestation. Only the HASH is ever sent.
GEOPROOF_SERVICE_URL=
# Stage 6. Anchors the decision HASH only; evidence is never anchored.
GEOPROOF_ANCHORING_ENABLED=false

# ─── Risk engine (Stages 3 & 4, 2026-08-14) ──────────────────────────────
# Two flags, and the split is the whole point: scoring must not quietly start
# withholding money.
#
# QUIZ_RISK_ENGINE_ENABLED=true alone is SHADOW MODE — every payout is scored
# and the verdict recorded, and every payout still settles. Run it for at least
# one full cycle and read the logs before going further; thresholds should be
# argued about against real cycles, not guessed.
QUIZ_RISK_ENGINE_ENABLED=false
# Only with this ALSO true does a `held` band park a payout for human review.
# Held is a PAUSE: points stay earned, the record stays queued, and !quizreview
# / !quizapprove / !quizreject decide. Rejection needs a human and a reason.
QUIZ_RISK_ENFORCEMENT_ENABLED=false

# ─── Participation signals (Stage 2, 2026-08-14) ─────────────────────────
# Collection ONLY. Nothing reads these yet — the risk engine is Stage 3 behind
# its own flag. Collecting first means that when enforcement is considered there
# is real history to tune it against instead of guesses.
#
# What is stored: a salted hash of the browser environment (user agent,
# platform, language, timezone, screen, memory, cores) and a salted hash of the
# network (/24 for IPv4, /48 for IPv6). Nothing raw. No GPS, no permission
# prompt, no canvas fingerprinting.
#
# Why: the 2026-08-14 abuse worked because a new wallet reset every limit.
# Nothing counted wallets per DEVICE.
PARTICIPATION_SIGNALS_ENABLED=false
# REQUIRED for any collection to happen — unset means no hashing at all, not
# weak hashing. A /24 has a tiny input space and is trivially reversed unsalted.
# Rotating this deliberately breaks correlation with older records; that is the
# retention mechanism, alongside the 90-day prune. SECRET.
PARTICIPATION_HASH_SALT=

# ─── Quiz payouts are SYSTEM-ONLY (owner decision, 2026-08-14) ───────────
# Leave this unset/false. On-demand redeeming is closed: points accrue and are
# paid when the cycle closes, plus the leaderboard payout. Nothing is lost.
#
# Why: the amount a wallet holds was never the control. A farmer moves the
# payout from wallet one to wallet two and keeps redeeming while the first
# cools off, so any per-wallet limit is beaten by owning another wallet. What
# cannot be faked is TIME — if the system decides when payouts happen, "claim
# ten times a day" stops existing and a second wallet buys nothing.
#
# It also fixes the economics: three 1,500-point redemptions cost three
# transactions in gas; the same points settled once at cycle close cost one.
#
# Set to true only to deliberately re-open instant payouts.
QUIZ_MANUAL_REDEEM_ENABLED=false

# ─── Quiz redemption holder gate (2026-08-14) ────────────────────────────
# Minimum WinLEW a linked wallet must hold to redeem quiz points.
#
# Until 2026-08-14 this path checked `balance > 0` and nothing else, while a
# comment claimed it mirrored the faucet's check. It did not. Observed abuse:
# buy a fraction of a token, pass the gate, redeem 1,500 WinLEW, move the
# payout to another wallet, repeat.
#
# UNSET INHERITS FAUCET_MIN_HOLDER_BALANCE, WHICH DEFAULTS TO 1 WinLEW —
# a fraction of a cent, and not a meaningful barrier. Set this deliberately.
# A defensible starting point is the redemption floor itself (1500), so a
# redeemer must hold at least what they are claiming.
QUIZ_MIN_HOLDER_BALANCE=

# ─── Site activity log (2026-08-14) ──────────────────────────────────────
# Posts a line to Discord whenever something happens on the WEBSITE — faucet
# claims, quiz redemptions, wallet sign-ins, merch captures, role syncs.
#
# Why: Discord has eyes on it, so abuse there is witnessed. The website has
# nobody watching, and the same actions happen there in silence.
#
# Prefer the webhook: it needs no bot permissions and cannot read the channel.
# Create one in the target channel (Edit Channel -> Integrations -> Webhooks).
# If unset, the bot token + channel id below are used instead. If neither is
# set, logging is silently inert — never an error. SECRET.
SITE_LOG_WEBHOOK_URL=
# Defaults to 1350969543480180817 (the channel the owner nominated) when unset.
SITE_LOG_CHANNEL_ID=

# Optional explicit bot tokens for linked-role metadata registration
MOLE_DISCORD_BOT_TOKEN=
UTILITY_DISCORD_BOT_TOKEN=
DISCORD_BOT_TOKEN=
BOT_SYNC_SECRET=change_me_to_a_long_random_string

# Price voice-channels (faucet bot renames these to the live price hourly).
