# Mole Guard / Utility OAuth app-specific overrides (optional but supported)
MOLE_DISCORD_CLIENT_ID=
MOLE_DISCORD_CLIENT_SECRET=
# Both of these are winlew.co proxy URLs in production, not tunnel URLs — see
# DISCORD_REDIRECT_URI near the top of this file.
