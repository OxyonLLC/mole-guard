SOCIAL_POSTS_CHANNEL_ID=1538658276831662271
# Where X/Twitter posts are announced. Set to a channel id (the bot must be able
# to see and send in it) and social posts go there instead of general chat —
# 🗣️-social-posts, created 2026-08-16. Leave blank and they fall back to
# GENERAL_WEBHOOK_URL, which is the old behaviour.
#
# The tweet-watcher's own OUTAGE notice deliberately still goes to the general
# webhook: "the watcher stopped" is an operational alert for maintainers, not a
# social post, and burying it in a feed channel is how it gets missed.

# A webhook that ALREADY points at the social channel — an alternative to the
# channel id above, tried second. Keep this separate from GENERAL_WEBHOOK_URL:
# repointing that one at the social channel would also move the tweet-watcher's
# outage alerts there, and "the watcher stopped" is for maintainers, not a feed.
#
# A webhook URL is a CREDENTIAL. Possession alone lets anyone post as it. Never
# paste one into chat, a commit, or an issue — if you do, regenerate it in
# Discord rather than deleting the message. `npm run scan:secrets` now flags them.
SOCIAL_POSTS_WEBHOOK_URL=
TWITTER_LAST_ID=
# Circuit breaker for the hourly tweet watcher (src/services/twitterHealth.js).
# A fatal X failure (402 credits, 401 token, 403 access) parks polling and posts
# ONE notice to the general webhook, instead of the old behaviour: a console.error
# once an hour that nobody reads, while tweets silently stopped being announced.
# Recovers by itself once X answers again — no restart.
# TWITTER_FAILURE_COOLDOWN_MS=          # default 21600000 (6h), floor 60000

# Mongo collection for the mobile wrapper session hand-off (short-lived,
# five-minute records, deleted on claim). Default mole_native_handoffs.
MOLE_NATIVE_HANDOFFS_COLLECTION=

# =========================
# OPTIONAL OVERRIDES — documented 2026-08-06
# =========================
# Everything below is read by the code but was NOT previously listed here.
# All of them are currently UNSET on the primary machine and the app runs fine,
# so they are genuine optional overrides, not missing required config. The
# value shown after each "default:" was read from the source, not assumed.
# Leave them commented out unless you intend to change the behaviour.

# ─── Faucet ───────────────────────────────────────────────────────────────
# FAUCET_DISABLED=false                  # true kills claiming entirely
# FAUCET_COOLDOWN_HOURS=24
# FAUCET_MIN_HOLDER_BALANCE=1            # must already hold this much to claim
# DISABLE_FAUCET_HOLDER_CHECK=false      # true removes the holder gate
# FAUCET_VERIFY_AFTER_CLAIMS=            # lifetime claims before verify required (10 in code)
                                         # Set to 0 to require verification from the FIRST claim.
                                         # At the default of 10, every freshly generated wallet gets
                                         # ten free claims before it has to prove anything — which is
                                         # the window the 2026-08-16 sybil run was positioning for.

# ── Identity-age gate (src/mole/identityAge.js) ───────────────────────────────
# Wallet verification used to prove only "has a Discord account", which costs an
# attacker about as much as generating a keypair. These measure how long the
# identity has EXISTED, which is the part that cannot be manufactured on demand.
# Applied at link time only; never retroactively un-verifies anyone.
# IDENTITY_GATE_ENABLED=                 # default true
# IDENTITY_MIN_ACCOUNT_AGE_DAYS=         # default 30. Snowflake-derived, no API call, cannot fail open.
# IDENTITY_MIN_GUILD_DAYS=               # default 3 (was 7 until 2026-08-20). Needs the bot token; fails OPEN
#                                        # if Discord is unreachable.
# IDENTITY_REQUIRE_SCREENING=            # default true. Refuses members who have not accepted the rules screen.
#                                        # Pair with Discord server verification level "Highest" (requires a
#                                        # verified phone) — that setting is what puts real cost on a second
#                                        # identity; this flag only enforces that they completed it.
# IDENTITY_FIRST_WALLET_MIN_BALANCE=     # default 100000. A person's FIRST wallet skips the two waiting
#                                        # periods when it holds at least this many WinLEW — waiting is a
#                                        # proxy for cost, and holding is cost itself. 0 disables the bypass
#                                        # without disabling the gate. It never waives being IN the server or
#                                        # having accepted the rules screen, because both are free.
#                                        # KNOWN LIMIT, on purpose: tokens move, so the same balance can be
#                                        # sent to a fresh wallet and used again under a second Discord
#                                        # account. Closing that needs holding DURATION, which needs a
#                                        # historical-balance indexer this project does not have. Every grant
#                                        # is logged to the site log as `identity_gate_holder_bypass`.

# ── Sign in / sync with X (src/mole/xOAuth.js) ───────────────────────────────
# "not everyone has discord and not every one has X" — so either one, on its
# own, proves a person and unlocks payouts. Discord stays the community's home;
# it is no longer the only door.
#
# TWITTER_BEARER_TOKEN ABOVE CANNOT DO THIS. That is app-only auth for reading
# tweets; it can never log a user in. This needs a separate X developer app with
# OAuth 2.0 (User Context) enabled at developer.x.com:
#
#   1. Create/choose an app, enable "OAuth 2.0", type: Web App (confidential).
#   2. Register the callback EXACTLY as X_REDIRECT_URI below — X refuses any
#      redirect_uri that is not a character-for-character match.
#   3. Request scopes users.read and tweet.read. offline.access is deliberately
#      NOT used: this reads an id once and never acts on anyone's behalf.
#
# Until all THREE are set the feature stays dormant — the API reports X as
# unavailable and the UI shows "coming soon" rather than a button that cannot
# work. Nothing breaks while it is unset.
#
# ROUTE THIS THROUGH winlew.co, NOT THE TUNNEL. The callback does run on the
# backend, but it must be REACHED at a winlew.co URL — /verify/api-proxy.php
# allowlists /x-oauth-callback and forwards it. Pointing this at the raw
# ngrok host walks every visitor's address bar through *.ngrok-free.dev on the
# way to a page that asks them to sign a message, which is what got winlew.co
# onto Phantom's malicious-site list. Same rule as DISCORD_REDIRECT_URI above.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=                        # https://winlew.co/verify/api-proxy.php/x-oauth-callback

# ── Appeal route on every refusal (src/services/appealContact.js) ────────────
# Every automated gate here can be wrong about a real person — cluster matching
# is explicitly a signal, not a proof, and housemates produce an abuser's exact
# signature. A refusal with no way back turns a false positive into a silent
# permanent ban. Defaults are baked in; override only if a channel changes.
# SUPPORT_EMAIL=                         # default support@winlew.co
# SUPPORT_CONTACT_URL=                   # default https://winlew.co/contact/
# SUPPORT_DISCORD_URL=                   # default https://winlew.co/community/

# ── New-profile burst guard (src/mole/web.js) ────────────────────────────────
# Separate from the /api/hub/wallet-login rate limit, which stays generous
# because repeated sign-ins are normal. Creating first-time profiles in volume
# is not: the 2026-08-16 run made 10 in one minute without ever approaching the
# 20-per-15s sign-in limit.
# WALLET_BURST_MAX_WALLETS=              # default 3 distinct wallet-only sign-ins
# WALLET_BURST_MAX_EVENTS=               # default 12 sign-ins total
# WALLET_BURST_WINDOW_MS=                # default 600000 (10 min), floor 60000
# HUB_REQUIRE_LOGIN_BEFORE_CONNECT=      # default FALSE. A wallet with no Discord
#                                        # account behind it must sign in before it can connect, so one
#                                        # person is one account. A wallet ALREADY linked still connects
#                                        # straight through — the mobile app depends on that path and a
#                                        # known member gains nothing by redoing OAuth.
#                                        # DO NOT SET THIS TO true YET. It shipped enabled on 2026-08-20
#                                        # and refused real people all day: there is no "Sign in with
#                                        # Discord" control anywhere in the site navigation, so the remedy
#                                        # the refusal names cannot be found by the person reading it.
#                                        # Turn it on only once a visible sign-in path exists.
#                                        # Sessions already issued are unaffected either way, and an
#                                        # anonymous player's progress merges when they link the same
#                                        # wallet.
#
# Tripping the burst guard now costs SIX MONTHS on a first offence and is
# PERMANENT on a second (src/shared/ipDenylist.js). Three wallets from one
# address is a low bar and a shared house or one person's phone-plus-laptop can
# reach it, so raise WALLET_BURST_MAX_WALLETS rather than switching the guard
# off if honest people start hitting it. Every refusal carries the appeal route.
# FAUCET_LINKAGE_DISABLED=false          # sybil-linkage detection off
# FAUCET_LINKAGE_MAX_DEPTH=
# FAUCET_PAYOUTS_DRY_RUN=                # 1/true/yes/on = log only, send nothing.
#                                       NOT any non-empty value — anything else
#                                       reads as false and pays for real.
# FAUCET_PAYOUT_MAX_BATCH=10
# FAUCET_PAYOUT_SCAN_MS=5000
# FAUCET_TREASURY_PUBKEY=
# FAUCET_WALLET_BANS_COLLECTION=faucet_wallet_bans

# ─── Quiz payouts (money path — set deliberately) ─────────────────────────
# QUIZ_PAYOUTS_ENABLED=                  # default: QUIZ_AUTO_PAYOUT_CYCLES || QUIZ_AUTO_PAYOUT_REDEEMS
# QUIZ_PAYOUTS_DRY_RUN=false             # true = log only, send nothing
# QUIZ_AUTO_PAYOUT_CYCLES=true
# QUIZ_AUTO_PAYOUT_REDEEMS=false
# QUIZ_PAYOUT_KEYPAIR_PATH=              # default resolves relative to src/quiz/
# QUIZ_PAYOUT_RPC_URL=                   # default: SOLANA_RPC, then RPC_URL
# QUIZ_PAYOUT_SCAN_MS=
# QUIZ_PAYOUT_MAX_BATCH=
# QUIZ_PAYOUT_MAX_ATTEMPTS=
# QUIZ_PAYOUT_RETRY_MS=
# QUIZ_PAYOUT_MISSING_WALLET_RETRY_MS=
# QUIZ_PAYOUT_ANNOUNCE_CHANNEL_ID=       # default: falls back to QUIZ_CHANNELS

# ─── Quiz gameplay ────────────────────────────────────────────────────────
# QUIZ_CHANNELS=                         # comma-separated channel ids
# QUIZ_COOLDOWN_MS=30000
# QUIZ_TIME_MS=15000

# ─── Discord tokens / scopes ──────────────────────────────────────────────
# Alternative token names some entry points accept. Prefer the canonical
# DISCORD_TOKEN / QUIZ_BOT_TOKEN etc. above; these are fallbacks.
# MOLE_TOKEN=
# QUIZ_TOKEN=
# FAUCET_TOKEN=
# MOLE_OAUTH_SCOPE=identify role_connections.write
# UTILITY_OAUTH_SCOPE=identify role_connections.write
# MOLE_GUILD_ROLE_SYNC_BOT_TOKEN=        # only if role sync uses a separate bot
# UTILITY_GUILD_ROLE_SYNC_BOT_TOKEN=

# ─── Misc ─────────────────────────────────────────────────────────────────
# WALLET_VERIFICATION_CYCLE_DAYS=91
# WEBSITE_BASE_URL=https://winlew.co
# SITE_CHECK_BASE=https://winlew.co      # used by npm run site:check
# SINGLE_INSTANCE_GUARD=                 # non-empty enables the single-instance lock
# DISCORD_WEBHOOK_URL=                   # generic webhook fallback
# CLAUDE_FAILURE_COOLDOWN_MS=            # watchdog circuit breaker pause
# SNS_API_BASE=https://sns-api.bonfida.com
# SNS_SUGGEST_PROXY_URL=https://sns-suggest-proxy.bonfida.com
#   NOTE 2026-08-06: Bonfida's hosted SNS proxy returned Cloudflare error 1042
#   during the /transparency/ audit. Resolving .sol names on-chain via
#   @bonfida/spl-name-service + the configured SOLANA_RPC worked fine, so if SNS
#   lookups start failing, suspect the hosted proxy before the code.

# ─── NOT Node config — these live on the SHARED HOST (PHP), not in this file
# The PHP proxies read these from the web host's environment, or from a
# sibling api-proxy-secret.php. Listed here only so nobody hunts for them.
#   WINLEW_API_BASE        -> src/public/verify/api-proxy.php   (tunnel URL)
#   WINLEW_PROXY_SECRET    -> must MATCH this file's WEB_PROXY_SHARED_SECRET
#                             (believed already set on the host; the Node side
#                              is the one in doubt — see register #27 and
#                              A.i-Talks/proxy-secret-2026-08-12.md)
#   GEOAGORA_API_BASE      -> src/public/geoagora/api-proxy.php
#   GEOAGORA_PUBLIC_BASE_PATH

# ─── Mongo collection-name overrides (only if MONGO_ENABLED=true) ─────────
# Defaults below are the collection names the code uses when unset. Change
# only to point at differently-named collections in an existing cluster.
# MOLE_CONTRIBUTIONS_COLLECTION=mole_contributions
# MOLE_EXTERNAL_CONTRIBUTIONS_COLLECTION=mole_external_contributions
