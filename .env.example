# =========================
# MOLE GUARD (Bot + Web + Linked Roles)
# =========================
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
PUBLIC_PORT=8788
HOST=127.0.0.1
WEB_HOST=127.0.0.1
PUBLIC_HOST=127.0.0.1
# Loopback is right when everything that reports lives on this machine.
#
# It is NOT right when something off-box heartbeats in -- the GeoHackers bot
# runs on another PC, and loopback binding is the reason it reached the
# watchdog through an ngrok tunnel at all. That tunnel was a free one, so its
# hostname changed on every restart; when it died the heartbeats 404'd and
# nothing was watching the bot until somebody read the logs.
#
# Set this to THIS MACHINE'S TAILSCALE IP (100.x.y.z) to accept heartbeats from
# other machines on the tailnet and nowhere else. Or set WATCHDOG_HOST=tailscale
# and the watchdog will resolve the current tailnet IPv4 at startup, failing
# closed if the CLI is missing or returns nothing. 0.0.0.0 works too but also
# listens on the LAN and anything else the box is plugged into; the tailnet
# address is the same convenience with none of that.
WATCHDOG_HOST=127.0.0.1
# Local dev uses localhost. IN PRODUCTION THIS MUST BE A winlew.co URL, not the
# ngrok host: /verify/api-proxy.php allowlists /discord-oauth-callback and
# forwards it to this backend, so the tunnel hostname never appears in a
# visitor's address bar. See the note beside X_REDIRECT_URI for why that
# matters (Phantom flagged winlew.co over exactly this redirect chain).
#   production: https://winlew.co/verify/api-proxy.php/discord-oauth-callback
DISCORD_REDIRECT_URI=http://localhost:8787/discord-oauth-callback

TOKEN_PEPPER=change_me_to_a_long_random_string

# which surfaced as "Verify failed: rpc_timeout" on /verify/ (2026-07-31).
# ─── Solana RPC ───────────────────────────────────────────────────────────
# REQUIRED: replace REPLACE_WITH_ALCHEMY_KEY with the project's Alchemy key
# (owner has it; same key already used for EVM chains). Do NOT leave a bare
# public endpoint here as the primary.
#
# Why: api.mainnet-beta.solana.com throttles and HANGS on
# verification, holder roles and payouts. It reached users as
# (2026-07-31). Keep the public endpoint only as the FALLBACK below.
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_KEY
# Only tried when the primary fails — see withRpcFailover() in
# src/mole/solana.js. Safe to leave as the free public endpoint.
# A SECOND PROVIDER, not the public endpoint. The chain is
#   SOLANA_RPC -> SOLANA_RPC_FALLBACK -> https://api.mainnet-beta.solana.com
# and identical URLs are de-duplicated, so setting this to the public endpoint
# collapses three tiers into two and leaves the public RPC as the only backup —
# which rate limits harder than the paid endpoint it is meant to rescue. The
# code warns once at startup when that is the case.
SOLANA_RPC_FALLBACK=
# ──────────────────────────────────────────────────────────────────────────
WINLEW_MINT=DnrcdQVH7fdbmm4EyD7LjT9mNNozF5HuWMeKcpvjpump

