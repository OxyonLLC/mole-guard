# Copy to .env and fill in the faucet / utility bot values
#
# ⚠ THIS FILE WINS OVER THE ROOT .env. src/faucet/faucet.js loads
# src/faucet/.env with `override: true` and only then the root .env with
# `override: false`, so any key set here beats the root value — fixing the
# root .env alone does NOT fix the faucet.
#
# This bit on 2026-08-01: RPC_URL here was still the bare public endpoint
# while the root .env had the keyed Alchemy one. The faucet used the public
# one, its confirmations timed out, and !drip reported succeeded claims as
# "still being verified" (they were finalized on-chain). Check this file
# first when the faucet behaves differently from the rest of the stack.
DISCORD_BOT_TOKEN=
# ─── Solana RPC ───────────────────────────────────────────────────────────
# REQUIRED: replace REPLACE_WITH_ALCHEMY_KEY with the project's Alchemy key
# (owner has it; same key already used for EVM chains). Do NOT leave a bare
# public endpoint here as the primary.
#
# Why: api.mainnet-beta.solana.com throttles and HANGS on
# getParsedTokenAccountsByOwner — the balance lookup behind wallet
# verification, holder roles and payouts. It reached users as
# "Verify failed: rpc_timeout:getParsedTokenAccountsByOwner" on /verify/
# (2026-07-31). Keep the public endpoint only as the FALLBACK below.
RPC_URL=https://solana-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_KEY
# Only tried when the primary fails — see withRpcFailover() in
# src/mole/solana.js. Safe to leave as the free public endpoint.
SOLANA_RPC_FALLBACK=https://api.mainnet-beta.solana.com
# ──────────────────────────────────────────────────────────────────────────

# Solana + payout identity
WINLEW_MINT=DnrcdQVH7fdbmm4EyD7LjT9mNNozF5HuWMeKcpvjpump
TOKEN_MINT=DnrcdQVH7fdbmm4EyD7LjT9mNNozF5HuWMeKcpvjpump
TOKEN_SYMBOL=WinLEW
BOT_KEYPAIR_PATH=./bot-keypair.json
BOT_PRIVATE_KEY_B58=
DRIP_AMOUNT=1500
MOD_IDS=

# Project wallet / pool metadata
BUY_MINT=DnrcdQVH7fdbmm4EyD7LjT9mNNozF5HuWMeKcpvjpump
POOL_NAME=SOL/WinLEW
WINLEW_POOL_ID=
WINLEW2_POOL_ID=
PUMPFUN_POOL_ID=
DEXSCREENER_POOL_ID=
DEXSCREENER_PAIR_ID=
GECKO_POOL_ID=
GECKO_PAIR_ID=
CMC_PAIR_ID=
RAYDIUM_POOL_ID=
RAYDIUM_PAIR_ID=
SOLSCAN_POOL_ID=
SOLSCAN_PUMP_ID=
SOLSCAN_RAYDIUM_ID=

# Price / swap API tuning
PUMPFUN_API_BASE=https://frontend-api.pump.fun
PUMPFUN_API_KEY=
PUMPFUN_QUOTE_URL=
PUMPFUN_SWAP_URL=
PUMP_SLIPPAGE_BPS=100
PUMP_PRIORITY=high
JUP_SLIPPAGE_BPS=200
JUP_PRIORITY_FEE=0.0005
# NOTE (2026-07-31): the previous QuickNode endpoint is DEAD — it fails the
# TLS handshake (ERR_SSL_TLSV1_ALERT_INTERNAL_ERROR), i.e. decommissioned or
# lapsed. src/faucet/sns.js reads this for .sol name lookups, so leave it
# blank rather than set to a broken URL, and check the QuickNode dashboard
# for billing on an endpoint that no longer exists.
QUICKNODE_URL=
QUICKNODE_HOST=
QUICKNODE_TOKEN=
SOLANA_DATASET=mainnet
SOLSCAN_API_KEY=

# Twitter / announcement relay (optional)
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=WinLewToken
TWITTER_USER_ID=
TWITTER_LAST_ID=

# Webhooks / channels (optional)
VOICE_WEBHOOK_URL=
VOICE_CHANNEL_ID=
PRICE_WEBHOOK_URL=
PRICE_CHANNEL_ID=
GENERAL_WEBHOOK_URL=
GENERAL_CHANNEL_ID=
ANNOUNCEMENT_WEBHOOK_URL=
ANNOUNCEMENTS_CHANNEL_ID=

# ─── Faucet behaviour ─────────────────────────────────────────────────────
# All optional — each falls back to the default shown, which is what runs if
# the line is absent. Defaults verified against src/faucet/config.js.

# Hours between claims for one identity. Default 24.
FAUCET_COOLDOWN_HOURS=
# Minimum WinLEW a wallet must already hold to claim (holder-only faucet).
FAUCET_MIN_HOLDER_BALANCE=
# Set true to skip the holder-balance check entirely. Default false.
DISABLE_FAUCET_HOLDER_CHECK=
# Set true to switch the faucet off completely. Default false (enabled).
FAUCET_DISABLED=
# The treasury's PUBLIC key. Optional, and deliberately public-only: it lets
# eligibility reject "claim to the treasury's own address" without the web
# process ever reading the keypair file.
FAUCET_TREASURY_PUBKEY=
# Set to 1/true/yes/on to run the payout worker in log-only mode (sends no
# payouts). NOT "any non-empty value" — payout-worker.js:29 matches that exact
# allowlist, so FAUCET_PAYOUTS_DRY_RUN=enabled (or =no, or =disabled) reads as
# FALSE and real payouts go out. Leave blank for normal operation.
FAUCET_PAYOUTS_DRY_RUN=

# ─── Anti-abuse (added v3.3.5) ────────────────────────────────────────────
# Lifetime confirmed claims after which a wallet must be verified to keep
# claiming — counted as the HIGHER of per-wallet and per-Discord-account.
# Default 10. Set 0 to disable the gate entirely.
# NOTE: this number is shown to users on /faucet/ and the mobile app home,
# which read it from /api/faucet/status — change it here, not in the pages.
FAUCET_VERIFY_AFTER_CLAIMS=
# Set true to switch off the on-chain funding-cluster ban check. Default
# false (enabled). With an empty ban list it refuses nobody and costs
# nothing, so leaving it on is the safe default.
FAUCET_LINKAGE_DISABLED=
# Funding hops followed out from a claiming wallet when checking bans.
# Default 2, clamped 0-4. Higher widens false matches faster than it catches
# anyone — sharing a funder is not proof of sharing a person.
FAUCET_LINKAGE_MAX_DEPTH=
# Mongo collection for the faucet ban list. Default faucet_wallet_bans.
# This one IS a source of truth and must be backed up; losing it un-bans
# everyone silently.
FAUCET_WALLET_BANS_COLLECTION=
