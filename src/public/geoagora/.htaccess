# GeoAgora web (Vite SPA) — served under /geoagora/ on shared hosting.
# Serves real files (assets, api-proxy.php) directly; routes everything else to the SPA.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /geoagora/
  # Real files / directories are served as-is (assets, api-proxy.php, manifest, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else falls through to the SPA entry point
  RewriteRule ^ index.html [L]
</IfModule>
