# Copy to .env and fill in your credentials
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-guild-id
DISCORD_GUILD_ID=your-guild-id

# Optional shared guild role sync
GUILD_ROLE_SYNC_ENABLED=true
GUILD_ROLE_SYNC_BOT_TOKEN=
VERIFIED_WALLET_ROLE_ID=
VERIFIED_HOLDERS_ROLE_ID=
LEWCREW_1M_ROLE_ID=
LEWCREW_10M_ROLE_ID=
LEWCREW_100M_ROLE_ID=

# Shared chain settings
WINLEW_MINT=DnrcdQVH7fdbmm4EyD7LjT9mNNozF5HuWMeKcpvjpump
# ─── Solana RPC ───────────────────────────────────────────────────────────
# REQUIRED: replace REPLACE_WITH_ALCHEMY_KEY with the project's Alchemy key
# (owner has it; same key already used for EVM chains). Do NOT leave a bare
# public endpoint here as the primary.
#
# Why: api.mainnet-beta.solana.com throttles and HANGS on
# getParsedTokenAccountsByOwner — the balance lookup behind wallet
# verification, holder roles and payouts. It reached users as
# "Verify failed: rpc_timeout:getParsedTokenAccountsByOwner" on /verify/
# (2026-07-31). Keep the public endpoint only as the FALLBACK below.
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_KEY
# Only tried when the primary fails — see withRpcFailover() in
# src/mole/solana.js. Safe to leave as the free public endpoint.
SOLANA_RPC_FALLBACK=https://api.mainnet-beta.solana.com
# ──────────────────────────────────────────────────────────────────────────

# Payout worker
QUIZ_PAYOUTS_ENABLED=true
QUIZ_AUTO_PAYOUT_CYCLES=true
QUIZ_AUTO_PAYOUT_REDEEMS=true
QUIZ_PAYOUTS_DRY_RUN=true
QUIZ_PAYOUT_ANNOUNCE_CHANNEL_ID=

# Cycle configuration
CYCLE_EPOCH=2026-01-01
CYCLE_LENGTH_DAYS=91

# Base points for regular quiz (Easy). Medium = x1.5, Hard = x2.25
BASE_POINTS=100

# Sponsored quiz points per correct answer
SPONSOR_BASE_POINTS=125

# WinLEW paid per point when cycles close or redeems are valued
QUIZ_WINLEW_PER_POINT=1

# Fail startup when malformed questions are detected
QUIZ_STRICT_VALIDATION=false
